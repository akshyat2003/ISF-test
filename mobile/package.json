{
  "name": "@sj/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "build:android:apk": "eas build -p android --profile production-apk",
    "build:android:preview": "eas build -p android --profile preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@sj/client": "workspace:*",
    "@sj/contracts": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "expo": "57.0.26",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
