{
  "expo": {
    "name": "Startup Jathara",
    "slug": "isf",
    "scheme": "startupjathara",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.isf.startupjathara",
      "supportsTablet": false
    },
    "android": {
      "package": "org.isf.startupjathara"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "notices"
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "updates": {
      "url": "https://u.expo.dev/de15689a-4d22-4478-b7c4-a397c3765481"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "de15689a-4d22-4478-b7c4-a397c3765481"
      }
    },
    "owner": "zeny2labs"
  }
}
