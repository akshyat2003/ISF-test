{
  "name": "@sj/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "staging:verify": "tsx scripts/staging-verify.ts",
    "ranking:eval": "tsx scripts/ranking-eval.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@sj/contracts": "workspace:*",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "nodemailer": "10.0.12",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "22.20.5",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
